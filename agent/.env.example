# LLM: any OpenAI-compatible endpoint (GLM / DeepSeek / OpenAI / vLLM / Ollama ...)
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your-key
LLM_MODEL=glm-4.7

# OpenNotebook REST API (the ON password set in the ON API middleware)
ON_BASE_URL=http://localhost:5055
ON_API_TOKEN=your-on-password

# Optional: protect this service. Must match ON's OPEN_NOTEBOOK_AGENT_TOKEN
# when ON proxies chat here; also required to call /extract directly.
AGENT_API_KEY=

# Server
AGENT_HOST=0.0.0.0
AGENT_PORT=5060

# Langfuse tracing (optional; absent = tracing off)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=http://localhost:3000
# LANGFUSE_TRACING_ENVIRONMENT=development

# Vision (chart reading VLM, separate from text LLM when it lacks vision)
# Falls back to LLM_* values when unset
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_API_KEY=your-vision-key
VISION_MODEL=glm-4.6v
